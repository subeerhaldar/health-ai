{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "rag-route": {
        "ClusterId": "rag-cluster",
        "Match": {
          "Path": "/rag/{**catch-all}"
        }
      },
      "mcp-route": {
        "ClusterId": "mcp-cluster",
        "Match": {
          "Path": "/mcp/{**catch-all}"
        }
      },
      "workflows-route": {
        "ClusterId": "workflows-cluster",
        "Match": {
          "Path": "/workflows/{**catch-all}"
        }
      },
      "orchestrator-route": {
        "ClusterId": "orchestrator-cluster",
        "Match": {
          "Path": "/orchestrator/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "rag-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ragservice-api:8080"
          }
        }
      },
      "mcp-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://mcpclient-api:8080"
          }
        }
      },
      "workflows-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://workflowengine-api:8080"
          }
        }
      },
      "orchestrator-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orchestrator-api:8080"
          }
        }
      }
    }
  }
}
