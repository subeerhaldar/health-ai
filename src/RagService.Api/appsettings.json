{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=healthai_db;Username=healthai;Password=YOUR_PASSWORD_HERE"
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "EmbeddingModel": "liquid/lfm-2.5-embedding-350m:free",
